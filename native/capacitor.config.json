{
  "appId": "com.ashmesh.app",
  "appName": "#ash Mesh",
  "webDir": "../client/dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "hostname": "ashmesh.com"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "AshMeshNative": {
      "serviceName": "_ashmesh._tcp",
      "maxPayloadBytes": 8388608
    }
  }
}
