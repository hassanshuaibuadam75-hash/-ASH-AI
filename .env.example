# #ash Mesh — environment configuration
# Copy to .env (never commit real secrets). All values are read on the server only.

# ---- Core ----
PORT=3000
# Where the SQLite database and uploaded media live. Use a persistent disk in production.
DATA_DIR=./data

# ---- Founder authority ----
# The account that registers with this email becomes the sole Founder/CEO.
# Leave empty until the Founder registers; no account is ever fabricated.
FOUNDER_EMAIL=

# ---- #ash AI (optional) ----
# Server-side Groq key. Without it the assistant reports "not configured" instead of faking replies.
GROQ_API_KEY=
ASH_AI_MODEL=llama-3.3-70b-versatile

# ---- Payments (optional, real provider) ----
# Without a key, orders are recorded as pending payment and no charge is ever simulated.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_CALLBACK_URL=https://your-domain/api/market/payments/verify

# ---- Transactional email (optional) ----
# Without a key, password reset links are written to the audit log for the operator instead of emailed.
RESEND_API_KEY=
MAIL_FROM=no-reply@ashmesh.com
PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (TEST project only during development) ----
# The app ships with its own SQLite data layer; these are used by supabase/migrations parity tooling.
SUPABASE_TEST_URL=https://wfnhlrwqwpiuqaamdbvz.supabase.co
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# ---- Local development only ----
# Set to 1 when testing over plain HTTP so cookies are not marked Secure.
FORCE_INSECURE_COOKIES=0
